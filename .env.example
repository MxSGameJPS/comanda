# Supabase - valores do Connect/API Keys do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=

# URL pública/base usada nos QR Codes das mesas.
# Produção: https://seu-dominio.com
# Teste no celular pela rede local: http://192.168.x.x:3000
NEXT_PUBLIC_APP_URL=

# Slug oculto do painel administrativo
ADMIN_ROUTE_SLUG=gestao

# Chave privada usada somente uma vez em /configurar para criar o primeiro OWNER.
# Use uma string longa e aleatória e não exponha em NEXT_PUBLIC_.
ADMIN_SETUP_KEY=

# Atalhos/mock visual somente quando você quiser testar o modo demonstrativo.
# Para a operação real do restaurante mantenha false.
NEXT_PUBLIC_ENABLE_DEMO=false
